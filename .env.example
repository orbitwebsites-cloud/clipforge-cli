# Deepgram — used for transcription. Takes whole files (~2 GB) in one request,
# so long streams need no chunking and are metered by balance, not audio/hour.
# Get one at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Cerebras — used for highlight-ranking LLM inference
# Get one at https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# ---- optional overrides ----
# Transcription model on Deepgram
DEEPGRAM_MODEL=nova-3
# Analysis model on Cerebras (run `cfc doctor` to see what your account can access)
CEREBRAS_MODEL=
# Port for the local OpenAI-compatible router
CFC_PROXY_PORT=8787
